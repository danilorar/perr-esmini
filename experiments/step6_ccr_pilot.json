{
  "name": "step6_ccr_pilot",
  "description": "Pilot: step6_ccr on ncap_ccrs_50 only. K-Radar anchored levels (0.5×/1×/2× at 30 m). 226 runs.",
  "scenarios": ["ncap_ccrs_50"],
  "groups": [
    {
      "name": "baseline",
      "set": {"errors": []},
      "seeds": [1]
    },
    {
      "name": "range_off",
      "set": {"errors": [{"type": "ou", "noise": "mixture", "p_outlier": 0}]},
      "vary": {"errors.ou.mae_pct": [0.72, 1.44, 2.87]},
      "seeds": {"first": 1, "count": 5}
    },
    {
      "name": "range_on",
      "set": {"errors": [{"type": "ou", "noise": "mixture", "p_outlier": 1}]},
      "vary": {"errors.ou.mae_pct": [0.72, 1.44, 2.87]},
      "seeds": {"first": 1, "count": 20}
    },
    {
      "name": "lateral_off",
      "set": {"errors": [{"type": "lateral", "noise": "mixture", "p_outlier": 0}]},
      "vary": {"errors.lateral.sigma_theta_deg": [0.25, 0.5, 1.0]},
      "seeds": {"first": 1, "count": 5}
    },
    {
      "name": "lateral_on",
      "set": {"errors": [{"type": "lateral", "noise": "mixture", "p_outlier": 1}]},
      "vary": {"errors.lateral.sigma_theta_deg": [0.25, 0.5, 1.0]},
      "seeds": {"first": 1, "count": 20}
    },
    {
      "name": "velocity_off_low",
      "set": {"errors": [{"type": "velocity", "sigma_radial_mps": 0.25, "sigma_tangential_mps": 1.0, "noise": "mixture", "p_outlier": 0}]},
      "seeds": {"first": 1, "count": 5}
    },
    {
      "name": "velocity_off_mid",
      "set": {"errors": [{"type": "velocity", "sigma_radial_mps": 0.5, "sigma_tangential_mps": 2.0, "noise": "mixture", "p_outlier": 0}]},
      "seeds": {"first": 1, "count": 5}
    },
    {
      "name": "velocity_off_high",
      "set": {"errors": [{"type": "velocity", "sigma_radial_mps": 1.0, "sigma_tangential_mps": 4.0, "noise": "mixture", "p_outlier": 0}]},
      "seeds": {"first": 1, "count": 5}
    },
    {
      "name": "velocity_on_low",
      "set": {"errors": [{"type": "velocity", "sigma_radial_mps": 0.25, "sigma_tangential_mps": 1.0, "noise": "mixture", "p_outlier": 1}]},
      "seeds": {"first": 1, "count": 20}
    },
    {
      "name": "velocity_on_mid",
      "set": {"errors": [{"type": "velocity", "sigma_radial_mps": 0.5, "sigma_tangential_mps": 2.0, "noise": "mixture", "p_outlier": 1}]},
      "seeds": {"first": 1, "count": 20}
    },
    {
      "name": "velocity_on_high",
      "set": {"errors": [{"type": "velocity", "sigma_radial_mps": 1.0, "sigma_tangential_mps": 4.0, "noise": "mixture", "p_outlier": 1}]},
      "seeds": {"first": 1, "count": 20}
    }
  ]
