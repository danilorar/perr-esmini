{
  "name": "step7_cyclist_speeds",
  "description": "Cyclist scenarios (cbfa, cbla, cbna) at 60 and 70 kph ego speed: baseline + range, lateral, velocity_radial, velocity_tangential at mid and high, outliers on. 50 seeds per group.",
  "scenarios": [
    "ncap_cbfa_60",
    "ncap_cbfa_70",
    "ncap_cbla_60",
    "ncap_cbla_70",
    "ncap_cbna_60",
    "ncap_cbna_70"
  ],
  "base": {
    "controller": "hidrive",
    "errors": []
  },
  "groups": [
    {
      "name": "baseline",
      "set": { "errors": [] },
      "seeds": { "first": 1, "count": 50 }
    },
    {
      "name": "range_on",
      "set": {
        "errors": [
          {
            "type": "ou",
            "noise": "mixture",
            "p_outlier": 1
          }
        ]
      },
      "vary": { "errors.ou.mae_pct": [1.44, 2.87] },
      "seeds": { "first": 1, "count": 50 }
    },
    {
      "name": "lateral_on",
      "set": {
        "errors": [
          {
            "type": "lateral",
            "noise": "mixture",
            "p_outlier": 1
          }
        ]
      },
      "vary": { "errors.lateral.sigma_theta_deg": [0.5, 1.0] },
      "seeds": { "first": 1, "count": 50 }
    },
    {
      "name": "velocity_radial_on",
      "set": {
        "errors": [
          {
            "type": "velocity",
            "sigma_tangential_mps": 0.0,
            "noise": "mixture",
            "p_outlier": 1
          }
        ]
      },
      "vary": { "errors.velocity.sigma_radial_mps": [0.5, 1.0] },
      "seeds": { "first": 1, "count": 50 }
    },
    {
      "name": "velocity_tangential_on",
      "set": {
        "errors": [
          {
            "type": "velocity",
            "sigma_radial_mps": 0.0,
            "bias_radial_mps": 0.0,
            "noise": "mixture",
            "p_outlier": 1
          }
        ]
      },
      "vary": { "errors.velocity.sigma_tangential_mps": [0.5, 1.0] },
      "seeds": { "first": 1, "count": 50 }
    }
  ]
}
