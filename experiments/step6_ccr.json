{
  "name": "step6_ccr",
  "description": "Step 6 sensitivity grid \u2014 CCR cluster. Three error types (range, lateral, velocity) at three magnitude levels (0.5\u00d7, 1\u00d7, 2\u00d7 of reference values), each with outlier off (p=0, 5 seeds) and outlier forced on (p=1, 20 seeds). Crash rate for any p is recoverable as (1-p)*rate_off + p*rate_on. 1150 runs total.",
  "scenarios": [
    "ncap_ccrs_50",
    "ncap_ccrb_50",
    "ncap_ccrm_50",
    "tasc_car_1549178",
    "tasc_car_1554254"
  ],
  "groups": [
    {
      "name": "baseline",
      "set": {
        "errors": []
      },
      "seeds": [
        1
      ]
    },
    {
      "name": "range_off",
      "set": {
        "errors": [
          {
            "type": "ou",
            "noise": "mixture",
            "p_outlier": 0
          }
        ]
      },
      "vary": {
        "errors.ou.mae_pct": [
          0.72,
          1.44,
          2.87
        ]
      },
      "seeds": {
        "first": 1,
        "count": 10
      }
    },
    {
      "name": "range_on",
      "set": {
        "errors": [
          {
