<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="OpenSCENARIO.xsd">
  <FileHeader revMajor="1" revMinor="3" date="2026-02-24T14:44:00" author="Vector Informatik GmbH" description="Base Scenario CBFA from Euro NCAP Crash Avoidance Frontal Collisions 2026 Protocol">
    <License name="Mozilla Public License Version 2.0" resource="https://www.mozilla.org/en-US/MPL/2.0/" spdxId="MPL-2.0" />
    <Properties>
      <Property name="DYNA4.Version" value="10.0.0" />
    </Properties>
  </FileHeader>
  <ParameterDeclarations>
    <ParameterDeclaration name="ImpactLocation" parameterType="double" value="50">
      <ConstraintGroup>
        <ValueConstraint rule="greaterOrEqual" value="10" />
        <ValueConstraint rule="lessOrEqual" value="90" />
      </ConstraintGroup>
    </ParameterDeclaration>
    <ParameterDeclaration name="Ego_speed_kph" parameterType="double" value="50" />
    <ParameterDeclaration name="Ego_initTTC" parameterType="double" value="6">
      <ConstraintGroup>
        <ValueConstraint value="5" rule="greaterThan" />
      </ConstraintGroup>
    </ParameterDeclaration>
    <ParameterDeclaration name="Ego_length" parameterType="double" value="4.358" />
    <ParameterDeclaration name="Ego_width" parameterType="double" value="1.815">
      
    </ParameterDeclaration>
    <ParameterDeclaration name="Ego_BBcenter_x" parameterType="double" value="1.349" />
    <ParameterDeclaration name="VRU_width" parameterType="double" value="0.5" />
    <ParameterDeclaration name="VRU_finalSpeed_kph" parameterType="double" value="20" />
    <ParameterDeclaration name="VRU_steadyStateDist" parameterType="double" value="22" />
    <ParameterDeclaration name="VRU_collisionPointOffset" parameterType="double" value="0.62">
      
    </ParameterDeclaration>
    <ParameterDeclaration name="VRU_lateralDist" parameterType="double" value="1">
      
    </ParameterDeclaration>
    <ParameterDeclaration name="ObstructionLarge_length" parameterType="double" value="4.418">
      <ConstraintGroup>
        <ValueConstraint rule="greaterOrEqual" value="4.3" />
        <ValueConstraint rule="lessOrEqual" value="4.7" />
      </ConstraintGroup>
    </ParameterDeclaration>
    <ParameterDeclaration name="ObstructionLarge_width" parameterType="double" value="1.82">
      <ConstraintGroup>
        <ValueConstraint rule="greaterOrEqual" value="1.75" />
        <ValueConstraint rule="lessOrEqual" value="1.9" />
      </ConstraintGroup>
    </ParameterDeclaration>
    <ParameterDeclaration name="ObstructionLarge_BBcenter_x" parameterType="double" value="1.399" />
    <ParameterDeclaration name="ObstructionSmall_width" parameterType="double" value="1.79">
      <ConstraintGroup>
        <ValueConstraint rule="greaterOrEqual" value="1.7" />
        <ValueConstraint rule="lessOrEqual" value="1.9" />
      </ConstraintGroup>
    </ParameterDeclaration>
    <ParameterDeclaration name="Obstruction_gap" parameterType="double" value="0.2">
      <ConstraintGroup>
        <ValueConstraint rule="greaterThan" value="0.1" />
        <ValueConstraint rule="lessThan" value="0.3" />
      </ConstraintGroup>
    </ParameterDeclaration>
    <ParameterDeclaration name="Road_armLength" parameterType="double" value="250" />
    <ParameterDeclaration name="Road_laneWidth" parameterType="double" value="3.5" />
    <ParameterDeclaration name="Road_radius" parameterType="double" value="8">
      
    </ParameterDeclaration>
    <ParameterDeclaration name="Scenario_ID" parameterType="string" value="CBFA">
      
    </ParameterDeclaration>
    <ParameterDeclaration name="_Road_radiusCenter" parameterType="double" value="${$Road_radius+$Road_laneWidth}">
      
    </ParameterDeclaration>
    <ParameterDeclaration name="_Road_collisionPointAQ" parameterType="double" value="${$Road_armLength+$_Road_radiusCenter+$Road_laneWidth/2}">
      
    </ParameterDeclaration>
    <ParameterDeclaration name="_Road_collisionPointBQ" parameterType="double" value="${$Road_armLength+$_Road_radiusCenter-$Road_laneWidth/2-$VRU_width/2}">
      
    </ParameterDeclaration>
    <ParameterDeclaration name="_collisionPoint_impactPointOffset" parameterType="double" value="${$Ego_width*($ImpactLocation/100)-$Ego_width/2}">
      
    </ParameterDeclaration>
    <ParameterDeclaration name="_Ego_frontBumperLon" parameterType="double" value="${$Ego_BBcenter_x+($Ego_length/2)}">
      
    </ParameterDeclaration>
    <ParameterDeclaration name="_Ego_speed" parameterType="double" value="${$Ego_speed_kph/3.6}">
      
    </ParameterDeclaration>
    <ParameterDeclaration name="_Ego_initS" parameterType="double" value="${$Road_armLength-$_Ego_speed*$Ego_initTTC}">
      <ConstraintGroup>
        <ValueConstraint rule="greaterThan" value="0" />
      </ConstraintGroup>
    </ParameterDeclaration>
    <ParameterDeclaration name="_VRU_finalSpeed" parameterType="double" value="${$VRU_finalSpeed_kph/3.6}">
      
    </ParameterDeclaration>
    <ParameterDeclaration name="_VRU_initS" parameterType="double" value="${$_Road_collisionPointAQ-$VRU_steadyStateDist-7}">
      
    </ParameterDeclaration>
    <ParameterDeclaration name="_ObstructionLarge_rearOverhang" parameterType="double" value="${$ObstructionLarge_length/2-$ObstructionLarge_BBcenter_x}" />
  </ParameterDeclarations>
  <VariableDeclarations>
    <VariableDeclaration name="collisionDetected" variableType="boolean" value="false" />
    <VariableDeclaration name="egoSpeedReached" variableType="double" value="0.0" />
  </VariableDeclarations>
  <CatalogLocations>
    <VehicleCatalog>
      <Directory path="../../../data/ncap/OpenSCENARIO/NCAP/Catalogs/Vehicles" />
    </VehicleCatalog>
    <RouteCatalog>
      <Directory path="../../../data/ncap/OpenSCENARIO/NCAP/Catalogs/Routes" />
    </RouteCatalog>
    <ManeuverCatalog>
      <Directory path="../../../data/ncap/OpenSCENARIO/NCAP/Catalogs/Maneuver" />
    </ManeuverCatalog>
    <EnvironmentCatalog>
      <Directory path="../../../data/ncap/OpenSCENARIO/NCAP/Catalogs/Environments" />
    </EnvironmentCatalog>
  </CatalogLocations>
  <RoadNetwork>
    <LogicFile filepath="ncap_cbfa_50.xodr" />
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <CatalogReference entryName="VW_Golf_Sportsvan_2015" catalogName="Vehicles" />
      <ObjectController>
        <Controller name="HiDriveController">
          <Properties>
            <Property name="timeGap" value="1.0" />
            <Property name="mode" value="normal" />
            <Property name="ADF_enabled" value="true" />
            <Property name="Speed_limit" value="100" />
            <Property name="setSpeed" value="13.8889" />
          </Properties>
        </Controller>
      </ObjectController>
    </ScenarioObject>
    <ScenarioObject name="VRU">
      <CatalogReference entryName="NCAP_Bicycle" catalogName="Vehicles" />
    </ScenarioObject>
    <ScenarioObject name="ObstructionSmall">
      <CatalogReference catalogName="Vehicles" entryName="NCAP_ObstructionVehicle_Small" />
    </ScenarioObject>
    <ScenarioObject name="ObstructionLarge">
      <CatalogReference catalogName="Vehicles" entryName="NCAP_ObstructionVehicle_Large" />
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <GlobalAction>
          <EnvironmentAction>
            <CatalogReference catalogName="Environments" entryName="Sunny" />
          </EnvironmentAction>
        </GlobalAction>
        <Private entityRef="Ego">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <RoutePosition>
                  <RouteRef>
                    <CatalogReference entryName="Ego_Intersection" catalogName="RouteCatalog" />
                  </RouteRef>
                  <InRoutePosition>
                    <FromLaneCoordinates laneId="-1" pathS="$_Ego_initS" laneOffset="0" />
                  </InRoutePosition>
                </RoutePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0" />
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$_Ego_speed" />
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
          <PrivateAction>
            <ControllerAction>
              <ActivateControllerAction longitudinal="true" lateral="true" />
            </ControllerAction>
          </PrivateAction>
          <PrivateAction>
            <RoutingAction>
              <AssignRouteAction>
                <CatalogReference entryName="Ego_Intersection" catalogName="RouteCatalog" />
              </AssignRouteAction>
            </RoutingAction>
          </PrivateAction>
        </Private>
        <Private entityRef="VRU">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <RoutePosition>
                  <RouteRef>
                    <CatalogReference entryName="VRU_Intersection_Farside" catalogName="RouteCatalog" />
                  </RouteRef>
                  <InRoutePosition>
                    <FromLaneCoordinates laneId="-1" pathS="$_VRU_initS" />
                  </InRoutePosition>
                </RoutePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <RoutingAction>
              <AssignRouteAction>
                <CatalogReference entryName="VRU_Intersection_Farside" catalogName="RouteCatalog" />
              </AssignRouteAction>
            </RoutingAction>
          </PrivateAction>
        </Private>
        <Private entityRef="ObstructionLarge">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <RoutePosition>
                  <RouteRef>
                    <CatalogReference catalogName="RouteCatalog" entryName="VRU_Intersection_Farside" />
                  </RouteRef>
                  <InRoutePosition>
                    <FromLaneCoordinates laneId="-1" pathS="${$_Road_collisionPointAQ-$VRU_steadyStateDist-$_ObstructionLarge_rearOverhang}" laneOffset="${-$ObstructionLarge_width/2-$VRU_width/2-$VRU_lateralDist}" />
                  </InRoutePosition>
                  <Orientation h="3.14159" type="relative" />
                </RoutePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>
        <Private entityRef="ObstructionSmall">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <RelativeObjectPosition entityRef="ObstructionLarge" dx="${$ObstructionLarge_length+$Obstruction_gap}" dy="${$ObstructionSmall_width/2-$ObstructionLarge_width/2}">
                </RelativeObjectPosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="NCAP_CA-FC_CBFA_2026">
      <Act name="Collision_Act">
        <ManeuverGroup name="Synchronization_CollisionDetection" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="VRU" />
          </Actors>
          <CatalogReference catalogName="ManeuverCatalog" entryName="LogAndSetVariables">
            <ParameterAssignments>
              <ParameterAssignment parameterRef="egoSpeed" value="$_Ego_speed" />
            </ParameterAssignments>
          </CatalogReference>
          <Maneuver name="VRU_Synchronization">
            <Event name="VRU_SynchronizeEvent" priority="override">
              <Action name="VRU_SynchronizeAction">
                <PrivateAction>
                  <SynchronizeAction masterEntityRef="Ego">
                    <TargetPositionMaster>
                      <RoutePosition>
                        <RouteRef>
                          <CatalogReference catalogName="RouteCatalog" entryName="Ego_Intersection" />
                        </RouteRef>
                        <InRoutePosition>
                          <FromRoadCoordinates t="0" pathS="${$_Road_collisionPointBQ-$_Ego_frontBumperLon}" />
                        </InRoutePosition>
                      </RoutePosition>
                    </TargetPositionMaster>
                    <TargetPosition>
                      <RoutePosition>
                        <RouteRef>
                          <CatalogReference catalogName="RouteCatalog" entryName="VRU_Intersection_Farside" />
                        </RouteRef>
                        <InRoutePosition>
                          <FromRoadCoordinates t="0" pathS="${$_Road_collisionPointAQ-$_collisionPoint_impactPointOffset-$VRU_collisionPointOffset}" />
                        </InRoutePosition>
                      </RoutePosition>
                    </TargetPosition>
                    <FinalSpeed>
                      <AbsoluteSpeed value="$_VRU_finalSpeed">
                        <TargetDistanceSteadyState distance="$VRU_steadyStateDist" />
                      </AbsoluteSpeed>
                    </FinalSpeed>
                  </SynchronizeAction>
                </PrivateAction>
              </Action>
            </Event>
          </Maneuver>
        </ManeuverGroup>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="StopAfterCollision" delay="1" conditionEdge="none">
          <ByValueCondition>
            <VariableCondition variableRef="collisionDetected" rule="equalTo" value="true" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
      <ConditionGroup>
        <Condition name="EgoSpeedReached" delay="1" conditionEdge="none">
          <ByValueCondition>
            <VariableCondition variableRef="egoSpeedReached" rule="greaterThan" value="0" />
          </ByValueCondition>
        </Condition>
        <Condition name="StopAtStandstill" delay="1" conditionEdge="none">
          <ByEntityCondition>
            <TriggeringEntities triggeringEntitiesRule="any">
              <EntityRef entityRef="Ego" />
            </TriggeringEntities>
            <EntityCondition>
              <StandStillCondition duration="0.1" />
            </EntityCondition>
          </ByEntityCondition>
        </Condition>
      </ConditionGroup>
      <ConditionGroup>
        <Condition name="StopAfterVRUCrossed" delay="0" conditionEdge="none">
          <ByEntityCondition>
            <TriggeringEntities triggeringEntitiesRule="any">
              <EntityRef entityRef="VRU" />
            </TriggeringEntities>
            <EntityCondition>
              <TraveledDistanceCondition value="${$Road_armLength+25-$_VRU_initS}" />
            </EntityCondition>
          </ByEntityCondition>
        </Condition>
      </ConditionGroup>
      <ConditionGroup>
        <Condition delay="0.0" conditionEdge="rising" name="SimTimeLimit">
          <ByValueCondition>
            <SimulationTimeCondition rule="greaterThan" value="15.0" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>