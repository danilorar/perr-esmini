OpenScenarioDrive-Linux-x86_64.AppImage
.venv 
.vscode

# Python cache
__pycache__/
*.pyc


# Ignore all files in the esmini-demo directory except results and scripts
esmini-demo/*
!esmini-demo/results/
!esmini-demo/results/**
!esmini-demo/scripts/
!esmini-demo/scripts/**


# Pipeline: compiled esmini and results stay local
runtime/
output/
# Raw TASC data (teacher data, never commit)
data/Rear-end car-car/
data/Rear-end car-cyclist/

# Scenarios imported with import-tasc stay local (teacher data); NCAP scenarios are tracked
pipeline/scenarios/imported/tasc_*
pipeline/scenarios/imported/gidas_*
pipeline/scenarios/imported/import_report.csv
pipeline/scenarios/imported/scenarios.json

# Archive 
archive/**


