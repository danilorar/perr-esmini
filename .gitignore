OpenScenarioDrive-Linux-x86_64.AppImage
.venv 
.vscode

# Python cache
__pycache__/
*.pyc


# Ignore all files in the esmini-demo directory except results and scripts
esmini-demo/*
!esmini-demo/results/
!esmini-demo/results/**
!esmini-demo/scripts/
!esmini-demo/scripts/**


# Pipeline: compiled esmini and results stay local
runtime/
output/
# Scenarios imported with import-tasc stay local (teacher data); NCAP scenarios are tracked
pipeline/scenarios/local/tasc_*
pipeline/scenarios/local/gidas_*
pipeline/scenarios/local/import_report.csv
pipeline/scenarios/local/scenarios.json

# Archive 
archive/**


