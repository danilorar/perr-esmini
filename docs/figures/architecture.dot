digraph pipeline {
    rankdir=TB
    nodesep=0.55
    ranksep=0.6
    fontname="Helvetica"

    node [fontname="Helvetica" fontsize=12 margin="0.22,0.14"
          style="rounded,filled" shape=box penwidth=1.6
          fillcolor="#f5f5f5" color="#888888" fontcolor="#333333"]
    edge [fontname="Helvetica" fontsize=9 color="#555555" penwidth=1.4]

    // ── I/O ──────────────────────────────────────────────────────────────────
    esmini [label="esmini\nGround truth"
            fillcolor="#dde8f5" color="#3b6cb5" fontcolor="#3b6cb5"]

    ctrl [label="AEB / ACC Controller"
          fillcolor="#dde8f5" color="#3b6cb5" fontcolor="#3b6cb5"]

    // ── Sensor Presets ───────────────────────────────────────────────────────
    subgraph cluster_gate {
        label="Sensor Presets"
        fontname="Helvetica" fontsize=10 fontcolor="#b45309"
        color="#b45309" style=dashed penwidth=1.6 bgcolor="transparent"

        range_gate [label="Range Gate\nsensor_max_range_m"
                    fillcolor="#fef9ec" color="#b45309" fontcolor="#b45309"]
        fov [label="FOV Filter\nsensor_fov_deg"
             fillcolor="#fef9ec" color="#b45309" fontcolor="#b45309"]
        { rank=same; range_gate fov }
    }

    // ── Detection (step 1) ───────────────────────────────────────────────────
    detection [label="detection\n(step 1 — first)\nframe dropout"
               fillcolor="#fce8e8" color="#cc3333" fontcolor="#cc3333" penwidth=2.0]

    // ── Measurement plugins ───────────────────────────────────────────────────
    subgraph cluster_meas {
        label="steps 2–5  (any order)"
        fontname="Helvetica" fontsize=10 color="#aaaaaa" style=dashed bgcolor="transparent"

        ou       [label="ou\nrange noise"]
        lateral  [label="lateral\nbearing noise"]
        velocity [label="velocity\nv_r · v_t noise"]
        box_node [label="box\ndimension error"]
        { rank=same; ou lateral velocity box_node }
    }

    // ── Object processing ─────────────────────────────────────────────────────
    identification [label="identification\n(step 6)\nobject class"
                    fillcolor="#fff7e0" color="#c48000" fontcolor="#c48000"]

    size [label="size\n(step 7)\nrange from box"
          fillcolor="#fff7e0" color="#c48000" fontcolor="#c48000"]

    // ── Edges ─────────────────────────────────────────────────────────────────
    esmini -> range_gate
    esmini -> fov

    range_gate -> detection
    fov -> detection

    detection -> ou
    detection -> lateral
    detection -> velocity
    detection -> box_node

    ou       -> identification
    lateral  -> identification
    velocity -> identification
    box_node -> identification

    identification -> size [label="class_correct" color="#c48000" fontcolor="#c48000"]

    size -> ctrl [label="predicted · seen" color="#cc3333" fontcolor="#cc3333"]
}
